# Copy to `.env` and adjust. Never commit `.env`.
#
# Connection string for apps on the host:
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
#
# From another Compose service on the same network (future agent-service):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@vector-db:5432/${POSTGRES_DB}

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_change_me
POSTGRES_DB=game_guide_ai
POSTGRES_PORT=5432

# OpenAI embedding model (text-embedding-3-small or text-embedding-3-large)
# Get your key from https://platform.openai.com/api-keys
# NEVER commit the real value — copy this file to .env and fill it in there
OPENAI_API_KEY=sk-replace-me

# --- RAG tuning knobs (optional) -------------------------------------------
# All optional; shown with their defaults. The canonical source + rationale for
# each is config.py. Uncomment and adjust to tune retrieval/generation without a
# code change or redeploy.
# RAG_TOP_K=10                 # chunks the vector search returns per query
# RAG_CONTEXT_TOP_N=5          # top chunks fed to the LLM context + cited sources
# RAG_SNIPPET_MAX=240          # max chars of each source's display snippet
# RAG_FALLBACK_DISTANCE=0.42   # ipl: top-1 distance above which a filtered query retries unfiltered
# RAG_ANSWERABLE_DISTANCE=0.50 # koz: top-1 distance within which the corpus is judged answerable
# RAG_DEFAULT_MODEL=gpt-4o-mini  # OpenAI chat model for answer generation
# RAG_TEMPERATURE=0.2          # answer-generation sampling temperature
# RAG_RERANK=0                 # gated cross-encoder rerank (needs `pip install '.[rerank]'`;
#                              # in Docker: build with --build-arg INSTALL_RERANK=1)

# --- Model routing providers (b8o.1, optional) ------------------------------
# gpt-4o-mini (OPENAI_API_KEY above) is the only ENABLED catalog entry today —
# see service/model_catalog.py. These three are disabled-by-default frozen v1
# candidates (docs/forge/plans/game-guide-ai-model-routing.md, "Provider
# onboarding and API keys"); construction is proven offline (no live calls),
# but none serve real traffic until Checkpoint 3's evaluation matrix passes.
# Uncomment + set only if you're testing a disabled profile's construction
# directly. NEVER commit real values — copy this file to .env and fill in there.
# DEEPSEEK_API_KEY=sk-replace-me    # https://platform.deepseek.com — deepseek-v4-flash
# DASHSCOPE_API_KEY=sk-replace-me   # Alibaba Model Studio, US (Virginia) — qwen-flash-us
# MOONSHOT_API_KEY=sk-replace-me    # https://platform.moonshot.ai — kimi-k3

# --- Auth / session (x5bz.2) -----------------------------------------------
# REQUIRED to run auth locally, and deliberately LEFT EMPTY here: a shipped
# placeholder would be a publicly known signing key, so anyone copying this file
# unchanged could forge a session cookie (including a DM one). The service fails
# CLOSED on an empty, placeholder, or too-short value — /auth/* returns 503 and
# nobody can log in until you set a real one:
#     openssl rand -base64 48
# In Cloud Run this comes from the `session-secret` Secret Manager entry — see
# docs/deploy-gcp.md. Changing it logs every user out.
SESSION_SECRET=

# Optional session knobs (defaults shown; canonical source is config.py).
# SESSION_TTL_DAYS=14          # how long a session cookie stays valid
# SESSION_COOKIE_NAME=gga_session
# SESSION_COOKIE_SECURE=1      # set 0 ONLY for local http dev — Cloud Run terminates
#                              # TLS and forwards http, so this must stay 1 in prod
# SESSION_COOKIE_SAMESITE=lax  # CSRF mitigation for the same-origin cookie-authed POSTs
# INVITE_TTL_DAYS=14           # default lifetime of a minted invite link
