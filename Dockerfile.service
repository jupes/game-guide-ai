FROM python:3.15-slim

WORKDIR /app

# Install the game-guide-ai package and dependencies from the same hashed lock
# used by the single-container image.
# .dockerignore still trims test files, data, and non-runtime ingestion modules.
# torch / sentence-transformers stay out of the DEFAULT image: the reranker is
# opt-in (RAG_RERANK=1 at runtime) and needs the [rerank] extra baked in via
#   docker compose build --build-arg INSTALL_RERANK=1 service
# The default build keeps the slim image; RAG_RERANK=1 without the extra just
# logs a warning and serves unreranked.
COPY pyproject.toml uv.lock ./
COPY config.py ./
COPY ingestion/ ingestion/
COPY service/ service/
ARG INSTALL_RERANK=0
RUN pip install --no-cache-dir uv==0.9.9 && \
    if [ "$INSTALL_RERANK" = "1" ]; then EXTRAS="--extra rerank"; else EXTRAS=""; fi && \
    uv export --frozen --no-emit-project --no-dev $EXTRAS \
        --format requirements-txt -o /tmp/requirements.txt && \
    pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && \
    pip install --no-cache-dir --no-deps . && \
    pip uninstall -y uv && rm /tmp/requirements.txt

EXPOSE 8000
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8000"]
