{
  "schema": "DocumentDeleteRequest",
  "direction": "request",
  "note": "POST /campaigns/{id}/documents/{id}/delete: deleting a document, and its whole history, asks for the password again (SEC-40). Only an archived document can be deleted (409 document_not_archived otherwise). The password is write-only: never logged, echoed or shown by repr.",
  "valid": [
    {
      "name": "a password",
      "value": {
        "schema_version": 1,
        "password": "correct horse battery staple"
      }
    }
  ],
  "invalid": [
    {
      "name": "no password",
      "why": "SEC-40: every document delete asks",
      "value": {
        "schema_version": 1
      }
    },
    {
      "name": "an empty password",
      "why": "at least one character",
      "value": {
        "schema_version": 1,
        "password": ""
      }
    },
    {
      "name": "a password past 1024",
      "why": "service/models.py's MAX_PASSWORD_LENGTH",
      "value": {
        "schema_version": 1,
        "password": "@repeat:p:1025"
      }
    },
    {
      "name": "a password as a number",
      "why": "no coercion between JSON types",
      "value": {
        "schema_version": 1,
        "password": 1234
      }
    },
    {
      "name": "a document id in the body",
      "why": "the path names the document; a request carries no key the contract does not declare",
      "value": {
        "schema_version": 1,
        "password": "correct horse battery staple",
        "document_id": "doc_aaaaaaaaaaaaaaaaaaaaaa"
      }
    }
  ]
}
